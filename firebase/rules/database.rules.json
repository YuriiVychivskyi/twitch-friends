{
  "rules": {
    ".read": false,
    ".write": false,
    "friendships": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "presence": {
      "$recipientUid": {
        ".read": "auth != null && auth.uid === $recipientUid",
        ".write": "auth != null && auth.uid === $recipientUid && !newData.exists()",
        "$senderUid": {
          ".write": "auth != null && auth.uid === $senderUid && (!newData.exists() || (root.child('friendships').child($senderUid).child($recipientUid).val() === true && root.child('friendships').child($recipientUid).child($senderUid).val() === true))",
          ".validate": "!newData.exists() || newData.hasChildren(['ciphertext', 'expiresAt', 'iv', 'version'])",
          "ciphertext": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{16,512}$/)"
          },
          "expiresAt": {
            ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 120000"
          },
          "iv": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{16}$/)"
          },
          "version": {
            ".validate": "newData.val() === 1"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
