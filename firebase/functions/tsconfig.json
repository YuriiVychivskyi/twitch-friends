{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "lib",
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "exclude": ["src/**/*.test.ts"],
  "include": ["src"]
}
