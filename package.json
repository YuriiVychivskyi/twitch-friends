{
  "name": "twitch-friends-extension",
  "version": "0.1.0",
  "private": true,
  "description": "A private, opt-in friend presence browser extension for twitch.tv.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "worker:dev": "wrangler dev",
    "worker:build": "wrangler deploy --dry-run --outdir .tmp/worker-build",
    "worker:deploy": "wrangler deploy",
    "worker:migrate:local": "wrangler d1 migrations apply twitch-friends --local",
    "worker:migrate:remote": "wrangler d1 migrations apply twitch-friends --remote",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "prepare": "wxt prepare",
    "typecheck": "tsc --noEmit && tsc --project worker/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run src",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:worker",
    "firebase:emulators": "firebase emulators:start --project demo-twitch-friends --only auth,database,firestore",
    "test:rules": "firebase emulators:exec --project demo-twitch-friends --only auth,database,firestore \"vitest run --config vitest.rules.config.ts\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "firebase": "12.16.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260728.1",
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "firebase-tools": "15.24.0",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "wrangler": "4.115.0",
    "wxt": "0.21.2"
  },
  "overrides": {
    "@opentelemetry/core": "2.8.0",
    "brace-expansion": "5.0.8",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  }
}
